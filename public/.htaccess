# =========================================================================
# Laravel Public .htaccess (Optimized & Secure)
# =========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect all traffic to HTTPS (optional, comment out if not using SSL)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Laravel core rewrite rules
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/storage/ [NC]
    RewriteCond %{REQUEST_URI} !^/payment_qr_codes/ [NC]
    RewriteRule ^ index.php [L]

    # Return 404 (not 403) for internal folders to reduce path disclosure
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|storage)/ - [L,NC,R=404]

    # Block direct access if someone forces /index.php explicitly
    RewriteRule ^index\.php$ - [F,L]
</IfModule>

# =========================================================================
# Security & Performance
# =========================================================================

# Prevent access to sensitive files
<FilesMatch "(\.env|\.htaccess|\.htpasswd|composer\.json|composer\.lock|artisan|package\.json|webpack\.mix\.js)$">
    Require all denied
</FilesMatch>

# (Handled above) Protect Laravel internal folders with 404

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), fullscreen=(self)"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# Disable directory listing and symlink following
Options -Indexes -FollowSymLinks +SymLinksIfOwnerMatch

# Disable server signature disclosure
ServerSignature Off

# Optional: block known bad bots and scanners
<IfModule mod_setenvif.c>
    SetEnvIfNoCase User-Agent "sqlmap" bad_bot
    SetEnvIfNoCase User-Agent "acunetix" bad_bot
    SetEnvIfNoCase User-Agent "nikto" bad_bot
    SetEnvIfNoCase User-Agent "masscan" bad_bot
    SetEnvIfNoCase User-Agent "zgrab" bad_bot
    SetEnvIfNoCase User-Agent "python-requests" bad_bot
</IfModule>

<IfModule mod_authz_core.c>
    <RequireAll>
        Require all granted
        Require not env bad_bot
    </RequireAll>
</IfModule>

# Block access to backup and config files
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|md)$">
    Require all denied
</FilesMatch>

# Prevent access to version control files
RedirectMatch 404 /\.git
RedirectMatch 404 /\.svn

# Disable HTTP TRACE method (anti XST)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^TRACE
    RewriteRule .* - [F]
</IfModule>

# Basic malicious query string filtering (conservative)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Common injection and wrapper probes
    RewriteCond %{QUERY_STRING} (base64_encode\(|concat_ws\(|group_concat\(|into\s+outfile|into\s+dumpfile|load_file\() [NC,OR]
    RewriteCond %{QUERY_STRING} (php://|phar://|expect://|data://) [NC,OR]
    RewriteCond %{QUERY_STRING} (\bGLOBALS\b|\b_REQUEST\b) [NC,OR]
    RewriteCond %{QUERY_STRING} (\beval\(|\bsystem\(|\bexec\(|\bpassthru\(|\bshell_exec\() [NC]
    RewriteRule .* - [F,L]
</IfModule>
